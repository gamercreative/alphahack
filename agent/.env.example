# Copy to agent/.env (git-ignored) and fill in. runner.py loads it at start; real env vars win.
# Anthropic (Claude Haiku 5.5) through Cornilia's OpenAI-compatible provider:
CORNILIA_PROVIDER=openai
CORNILIA_BASE_URL=https://api.anthropic.com/v1/
CORNILIA_API_KEY=paste-your-anthropic-api-key-here
CORNILIA_MODEL=claude-haiku-5-5
CORNILIA_MAX_TOKENS=2048
CORNILIA_TIMEOUT=120
# Local Ollama instead: CORNILIA_PROVIDER=ollama, CORNILIA_BASE_URL=http://localhost:11434/v1,
# CORNILIA_API_KEY=ollama, CORNILIA_MODEL=qwen3.5:35b-a3b
