// Source of truth for the data model. Keep in sync with db/migrations/*.up.sql
// and internal/queries/models.go. Paste into dbdiagram.io to view.

Project alphahack {
  database_type: 'PostgreSQL'
  Note: 'Agent backend: agents own conversations; each user turn creates a run with a tool-call trace.'
}

Table agents {
  id text [pk, default: `gen_random_uuid()::text`]
  name text [not null, note: 'non-empty']
  system_prompt text [not null, default: '']
  model text [not null, default: '', note: 'empty = server default (ANTHROPIC_MODEL)']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table conversations {
  id text [pk, default: `gen_random_uuid()::text`]
  agent_id text [not null, ref: > agents.id, note: 'ON DELETE CASCADE']
  title text [not null, default: '']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`, note: 'bumped on every new message']

  indexes {
    (agent_id, created_at) [name: 'conversations_agent_idx']
  }
}

Table runs {
  id text [pk, default: `gen_random_uuid()::text`]
  conversation_id text [not null, ref: > conversations.id, note: 'ON DELETE CASCADE']
  status text [not null, default: 'running', note: 'running | completed | failed']
  stop_reason text [not null, default: '', note: 'end_turn | max_tokens | refusal | max_iterations | ...']
  error text [not null, default: '']
  model text [not null, default: '']
  input_tokens bigint [not null, default: 0]
  output_tokens bigint [not null, default: 0]
  iterations integer [not null, default: 0, note: 'model round-trips in the agent loop']
  started_at timestamptz [not null, default: `now()`]
  finished_at timestamptz [null]

  indexes {
    (conversation_id, started_at) [name: 'runs_conversation_idx']
  }
}

Table messages {
  id text [pk, default: `gen_random_uuid()::text`]
  seq bigint [not null, increment, note: 'stable ordering within a conversation']
  conversation_id text [not null, ref: > conversations.id, note: 'ON DELETE CASCADE']
  run_id text [null, ref: > runs.id, note: 'ON DELETE SET NULL']
  role text [not null, note: 'user | assistant']
  content text [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (conversation_id, seq) [name: 'messages_conversation_seq_idx']
  }
}

Table tool_calls {
  id text [pk, default: `gen_random_uuid()::text`]
  seq bigint [not null, increment]
  run_id text [not null, ref: > runs.id, note: 'ON DELETE CASCADE']
  name text [not null]
  input jsonb [not null, default: '{}']
  output text [not null, default: '']
  is_error boolean [not null, default: false]
  duration_ms integer [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (run_id, seq) [name: 'tool_calls_run_seq_idx']
  }
}

// ---- B2C pharmacy (0002_pharmacy_base) --------------------------------------
// Money is bigint cents. Tag lists are jsonb arrays of strings.

Table branches {
  id text [pk, default: `gen_random_uuid()::text`]
  name text [not null, note: 'non-empty']
  city text [not null, note: 'non-empty']
  address text [not null, default: '']
  phone text [not null, default: '']
  supports_delivery boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
}

Table medications {
  id text [pk, default: `gen_random_uuid()::text`]
  brand_name text [not null, note: 'non-empty']
  active_ingredient text [not null, note: 'non-empty']
  therapeutic_class text [not null, default: '']
  dosage_form text [not null, note: 'tablet | capsule | syrup | inhaler | injection | cream | drops']
  strength text [not null, note: 'non-empty']
  rx_required boolean [not null, default: false]
  controlled boolean [not null, default: false]
  chronic_eligible boolean [not null, default: false]
  unit_price_cents bigint [not null, note: '>= 0']
  contraindication_tags jsonb [not null, default: '[]']
  description text [not null, default: '']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    active_ingredient [name: 'medications_active_ingredient_idx']
    brand_name [name: 'medications_brand_name_idx']
  }
}

Table inventory_batches {
  id text [pk, default: `gen_random_uuid()::text`]
  branch_id text [not null, ref: > branches.id, note: 'ON DELETE CASCADE']
  medication_id text [not null, ref: > medications.id, note: 'ON DELETE CASCADE']
  batch_number text [not null, note: 'non-empty']
  expiry_date timestamptz [not null]
  quantity_on_hand integer [not null, default: 0, note: '>= 0']
  quantity_reserved integer [not null, default: 0, note: '0 <= reserved <= on_hand']
  is_recalled boolean [not null, default: false]
  recall_reason text [not null, default: '']
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (branch_id, medication_id, batch_number) [unique, name: 'inventory_batches_branch_med_batch_uidx']
    (branch_id, medication_id, expiry_date) [name: 'inventory_batches_fefo_idx']
  }
}

Table customers {
  id text [pk, default: `gen_random_uuid()::text`]
  full_name text [not null, note: 'non-empty']
  phone text [not null, unique, note: 'non-empty']
  email text [not null, default: '']
  address text [not null, default: '']
  allergies jsonb [not null, default: '[]']
  chronic_conditions jsonb [not null, default: '[]']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table prescriptions {
  id text [pk, default: `gen_random_uuid()::text`]
  customer_id text [not null, ref: > customers.id, note: 'ON DELETE CASCADE']
  medication_id text [not null, ref: > medications.id, note: 'ON DELETE RESTRICT']
  doctor_name text [not null, note: 'non-empty']
  dosage_instructions text [not null, default: '']
  allowed_refills integer [not null, default: 1, note: '>= 0']
  remaining_refills integer [not null, default: 1, note: '0 <= remaining <= allowed']
  status text [not null, default: 'pending', note: 'pending | verified | rejected | expired']
  notes text [not null, default: '']
  expires_at timestamptz [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (customer_id, status) [name: 'prescriptions_customer_status_idx']
  }
}

Table carts {
  id text [pk, default: `gen_random_uuid()::text`]
  customer_id text [not null, ref: > customers.id, note: 'ON DELETE CASCADE']
  branch_id text [not null, ref: > branches.id, note: 'ON DELETE CASCADE']
  status text [not null, default: 'active', note: 'active | checked_out | abandoned']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (customer_id, status) [name: 'carts_customer_status_idx']
  }
}

Table cart_items {
  id text [pk, default: `gen_random_uuid()::text`]
  cart_id text [not null, ref: > carts.id, note: 'ON DELETE CASCADE']
  medication_id text [not null, ref: > medications.id, note: 'ON DELETE RESTRICT']
  prescription_id text [null, ref: > prescriptions.id, note: 'ON DELETE SET NULL']
  quantity integer [not null, note: '> 0']
  unit_price_cents bigint [not null, note: '>= 0']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (cart_id, medication_id) [unique, name: 'cart_items_cart_med_uidx']
  }
}

Table orders {
  id text [pk, default: `gen_random_uuid()::text`]
  customer_id text [not null, ref: > customers.id, note: 'ON DELETE RESTRICT']
  branch_id text [not null, ref: > branches.id, note: 'ON DELETE RESTRICT']
  cart_id text [null, ref: > carts.id, note: 'ON DELETE SET NULL']
  status text [not null, default: 'confirmed', note: 'pending_rx | confirmed | ready_for_pickup | out_for_delivery | completed | cancelled']
  fulfillment_type text [not null, note: 'pickup | delivery']
  delivery_address text [not null, default: '']
  total_cents bigint [not null, note: '>= 0']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (customer_id, created_at) [name: 'orders_customer_created_idx']
  }
}

Table order_items {
  id text [pk, default: `gen_random_uuid()::text`]
  order_id text [not null, ref: > orders.id, note: 'ON DELETE CASCADE']
  medication_id text [not null, ref: > medications.id, note: 'ON DELETE RESTRICT']
  batch_id text [not null, ref: > inventory_batches.id, note: 'ON DELETE RESTRICT']
  quantity integer [not null, note: '> 0']
  unit_price_cents bigint [not null, note: '>= 0']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    order_id [name: 'order_items_order_idx']
  }
}

Table refill_subscriptions {
  id text [pk, default: `gen_random_uuid()::text`]
  customer_id text [not null, ref: > customers.id, note: 'ON DELETE CASCADE']
  medication_id text [not null, ref: > medications.id, note: 'ON DELETE RESTRICT']
  branch_id text [not null, ref: > branches.id, note: 'ON DELETE RESTRICT']
  prescription_id text [null, ref: > prescriptions.id, note: 'ON DELETE SET NULL']
  interval_days integer [not null, note: '7..90']
  next_refill_at timestamptz [not null]
  status text [not null, default: 'active', note: 'active | paused | cancelled']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (customer_id, next_refill_at) [name: 'refill_subscriptions_customer_idx']
  }
}

// Wassit enquiry tables (staff, enquiries, enquiry_targets, outbox_messages,
// enquiry_events, agent runs) are defined in db/migrations/0004_enquiries.up.sql.

Table target_offers {
  id text [pk, default: `gen_random_uuid()::text`]
  enquiry_id text [not null, note: 'enquiries.id, ON DELETE CASCADE']
  target_id text [not null, note: 'enquiry_targets.id, ON DELETE CASCADE']
  branch_id text [not null, ref: > branches.id]
  source_text text [not null, note: 'copy of the pharmacist reply the fields were read from']
  extracted_by text [not null, note: 'staff | agent']
  in_stock boolean [null]
  strength text [not null, default: '']
  quantity integer [null, note: '>= 0']
  price_cents bigint [null, note: '>= 0']
  currency text [not null, default: '']
  pickup_by text [not null, default: '', note: 'free text, e.g. "before 18:00"']
  payment text [not null, default: '', note: "'' | cash | card | any"]
  needs_prescription boolean [null]
  evidence jsonb [not null, default: '{}', note: 'field -> exact quote from source_text']
  confidence double [not null, note: '0..1']
  decision text [not null, note: 'matches | escalated | rejected (decided in Go rules)']
  decided_by text [not null, default: 'rules', note: 'rules | human']
  reasons jsonb [not null, default: '[]']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (enquiry_id, created_at) [name: 'target_offers_enquiry_idx']
  }
}

// Government reference (0007_gov_reference). Seed rows are labelled
// source = 'Demo seed, not real MoPH data'. Read by anyone, written by staff only.
Table reference_documents {
  id text [pk, default: `gen_random_uuid()::text`]
  name text [not null, note: 'original file name']
  content_type text [not null, note: 'application/pdf | image/png | image/jpeg (sniffed)']
  size_bytes bigint [not null, note: '>= 0, max 10 MB']
  sha256 text [not null, note: 'hex sha256 of the file']
  uploaded_by_staff_id text [not null, note: 'staff.id']
  storage_path text [not null, note: 'UPLOAD_DIR/reference/<id><ext>; never returned by the API']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (created_at, id) [name: 'reference_documents_created_idx']
  }
}

Table gov_products {
  code text [pk, note: '13 digits']
  reg_no text [not null]
  brand_name text [not null]
  ingredient text [not null, note: 'combined ingredients joined with /']
  strength text [not null, note: 'e.g. 1000mg, 100mcg']
  dosage_form text [not null]
  official_price_cents bigint [not null, note: '>= 0']
  source text [not null]
  document_id text [null, ref: > reference_documents.id, note: 'ON DELETE SET NULL']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (ingredient, strength, dosage_form, brand_name) [unique]
    `lower(ingredient)` [name: 'gov_products_ingredient_idx']
  }
}

// DOSYN clients (0008_clients). Never linked to `customers`. enquiry_events.actor_type
// also allows 'client'. Seed: branch-client-desk ('DOSYN client desk', participating
// = false, no lat/lng), staff desk@wassit.demo (role reviewer), client Maya.
Table clients {
  id text [pk, default: `gen_random_uuid()::text`]
  display_name text [not null]
  phone text [not null, unique]
  pin_hash text [not null, note: 'hex sha256 of the PIN']
  created_at timestamptz [not null, default: `now()`]
}

Table client_sessions {
  token_hash text [pk, note: 'hex sha256 of the c_ token']
  client_id text [not null, ref: > clients.id, note: 'ON DELETE CASCADE']
  expires_at timestamptz [not null]
}

// Schedules and tickets (0009_schedules_tickets). A ticket wraps one client-desk enquiry.
Table medicine_schedules {
  id text [pk, default: `gen_random_uuid()::text`]
  client_id text [not null, ref: > clients.id, note: 'ON DELETE CASCADE']
  medication_id text [not null, ref: > medications.id]
  quantity integer [not null, note: '1..10']
  every text [not null, note: 'week | 2weeks | month']
  weekday integer [not null, note: '0 (Sunday) .. 6']
  pickup_window text [not null]
  no_bulk boolean [not null, default: true]
  status text [not null, default: 'active', note: 'active | paused']
  next_run_at timestamptz [not null, note: 'weekday 09:00 Asia/Beirut']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (status, next_run_at) [name: 'medicine_schedules_due_idx']
    (client_id, created_at) [name: 'medicine_schedules_client_idx']
  }
}

Table client_tickets {
  id text [pk, default: `gen_random_uuid()::text`]
  client_id text [not null, ref: > clients.id, note: 'ON DELETE CASCADE']
  enquiry_id text [not null, unique, note: 'enquiries.id, ON DELETE CASCADE']
  schedule_id text [null, ref: > medicine_schedules.id, note: 'ON DELETE SET NULL']
  mode text [not null, note: 'once | scheduled']
  pickup_window text [not null, note: 'one of the fixed UI values']
  status text [not null, default: 'open', note: 'open | reserved | closed']
  reserved_branch_id text [null, ref: > branches.id]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (client_id, created_at) [name: 'client_tickets_client_idx']
    schedule_id [name: 'client_tickets_schedule_idx']
  }
}

// Package photos (0010_package_photos): evidence, not proof (rule 10).
Table package_photos {
  id text [pk, default: `gen_random_uuid()::text`]
  target_id text [not null, note: 'enquiry_targets.id, ON DELETE CASCADE']
  branch_id text [not null, ref: > branches.id]
  storage_path text [not null, note: 'UPLOAD_DIR/photos/<id><ext>; never returned by the API']
  content_type text [not null, note: 'image/jpeg | image/png (sniffed)']
  size_bytes bigint [not null, note: 'max 5 MB']
  typed_code text [not null, default: '', note: 'typed by the target pharmacist']
  typed_expiry_month text [not null, default: '', note: 'YYYY-MM']
  status text [not null, note: 'verified | flagged | mismatch | rejected']
  gov_match boolean [not null, default: false]
  decided_by text [not null, note: 'rules | human']
  note text [not null, default: '']
  reviewed_by_staff_id text [null, note: 'staff.id (reviewer)']
  agent_code text [not null, default: '', note: "the agent's reading"]
  agent_expiry_month text [not null, default: '']
  agent_confidence double [null, note: '0..1']
  read_at timestamptz [null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (target_id, created_at) [name: 'package_photos_target_idx']
  }
}
